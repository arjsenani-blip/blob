{
  "name": "blob",
  "version": "1.1.0",
  "description": "Blob \u2014 your planner and voice assistant, for Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/parser.test.js test/core.test.js test/tracking.test.js",
    "dist": "electron-builder --win --x64"
  },
  "author": "Arjun Senani",
  "license": "UNLICENSED",
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "productName": "Blob",
  "optionalDependencies": {
    "sherpa-onnx-win-x64": "1.13.8"
  },
  "build": {
    "appId": "com.arjunsenani.blob",
    "productName": "Blob",
    "copyright": "Made for Arjun",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/sherpa-onnx-darwin-*/**",
      "!node_modules/sherpa-onnx-linux-*/**"
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Blob",
      "artifactName": "Blob-Setup-${version}.exe",
      "runAfterFinish": true
    }
  }
}